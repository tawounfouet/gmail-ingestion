# Runtime
GMAIL_INGESTION_ENV=dev
GMAIL_INGESTION_STORAGE_URI=./data

# Optional local account context for future orchestration.
GMAIL_INGESTION_ACCOUNT_ID=

# OAuth Desktop configuration.
# These are documentation placeholders; never commit actual secrets or tokens.
GMAIL_OAUTH_CLIENT_SECRETS_FILE=credentials.json
GMAIL_INGESTION_CREDENTIAL_DIR=~/.local/share/gmail-ingestion/credentials
