# Runtime
GMAIL_INGESTION_ENV=dev
GMAIL_INGESTION_STORAGE_URI=./data

# Account context (opaque identifier preferred; do not use an email address in paths)
GMAIL_INGESTION_ACCOUNT_ID=

# OAuth configuration will be activated in milestone 0.1.0a1.
# Never commit client secrets or tokens.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET_REF=
